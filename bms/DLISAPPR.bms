DST4AUT  DFHMDF POS=(13,43),LENGTH=30,ATTRB=(PROT,NORM)
         DFHMDF POS=(14,2),LENGTH=23,ATTRB=(PROT,NORM),               X
               INITIAL='5. SECOND APPROVAL  : '
DST5STS  DFHMDF POS=(14,25),LENGTH=6,ATTRB=(PROT,BRT)
DST5DAT  DFHMDF POS=(14,32),LENGTH=10,ATTRB=(PROT,NORM)
DST5AUT  DFHMDF POS=(14,43),LENGTH=30,ATTRB=(PROT,NORM)
         DFHMDF POS=(15,1),LENGTH=80,ATTRB=(PROT,NORM),               X
