         TITLE 'DLIS BMS MAPSETS - APPROVAL AUTH1, AUTH2, LICENSE ISSUE, STATUS'
***================================================================***
*** BMS Mapset : DLISA1 - FIRST AUTHORITY APPROVAL                 ***
*** Map        : DLISA1M01  Trans: DL08                            ***
***================================================================***
DLISA1   DFHMSD TYPE=&SYSPARM,                                         X
               LANG=COBOL,MODE=INOUT,TERM=3270-2,                      X
               CTRL=FREEKB,STORAGE=AUTO,TIOAPFX=YES

DLISA1M01 DFHMDI SIZE=(24,80),LINE=1,COLUMN=1

         DFHMDF POS=(1,1),LENGTH=80,ATTRB=(PROT,BRT),                 X
               INITIAL='DLIS            FIRST AUTHORITY APPROVAL'
DA1DATE  DFHMDF POS=(1,72),LENGTH=10,ATTRB=(PROT,NORM)
         DFHMDF POS=(2,1),LENGTH=80,ATTRB=(PROT,NORM),                X
               INITIAL='--------------------------------------------------------------------------------'

         DFHMDF POS=(4,2),LENGTH=18,ATTRB=(PROT,NORM),                X
               INITIAL='APPLICATION ID  : '
DA1AID   DFHMDF POS=(4,20),LENGTH=10,ATTRB=(NUM,UNPROT,IC)
         DFHMDF POS=(5,2),LENGTH=18,ATTRB=(PROT,NORM),                X
               INITIAL='CANDIDATE NAME  : '
DA1CNAM  DFHMDF POS=(5,20),LENGTH=60,ATTRB=(PROT,NORM)
         DFHMDF POS=(6,2),LENGTH=18,ATTRB=(PROT,NORM),                X
               INITIAL='LICENSE TYPE    : '
DA1LTYP  DFHMDF POS=(6,20),LENGTH=1,ATTRB=(PROT,NORM)
DA1LDSC  DFHMDF POS=(6,22),LENGTH=20,ATTRB=(PROT,NORM)
         DFHMDF POS=(7,2),LENGTH=18,ATTRB=(PROT,NORM),                X
               INITIAL='APP STATUS      : '
DA1ASTT  DFHMDF POS=(7,20),LENGTH=2,ATTRB=(PROT,NORM)
DA1ADSC  DFHMDF POS=(7,23),LENGTH=40,ATTRB=(PROT,NORM)
         DFHMDF POS=(8,1),LENGTH=80,ATTRB=(PROT,NORM),                X
               INITIAL='--------------------------------------------------------------------------------'
         DFHMDF POS=(9,2),LENGTH=18,ATTRB=(PROT,NORM),                X
               INITIAL='ELIG CHECK      : '
DA1ELIG  DFHMDF POS=(9,20),LENGTH=1,ATTRB=(PROT,BRT)
DA1ELNT  DFHMDF POS=(9,22),LENGTH=40,ATTRB=(PROT,NORM)
         DFHMDF POS=(10,2),LENGTH=18,ATTRB=(PROT,NORM),               X
               INITIAL='HISTORY CHECK   : '
DA1HIST  DFHMDF POS=(10,20),LENGTH=1,ATTRB=(PROT,BRT)
DA1HSNT  DFHMDF POS=(10,22),LENGTH=40,ATTRB=(PROT,NORM)
         DFHMDF POS=(11,2),LENGTH=18,ATTRB=(PROT,NORM),               X
               INITIAL='PAYMENT         : '
DA1PAY   DFHMDF POS=(11,20),LENGTH=1,ATTRB=(PROT,BRT)
DA1PYRF  DFHMDF POS=(11,22),LENGTH=20,ATTRB=(PROT,NORM)
         DFHMDF POS=(12,1),LENGTH=80,ATTRB=(PROT,NORM),               X
               INITIAL='--------------------------------------------------------------------------------'
         DFHMDF POS=(13,2),LENGTH=18,ATTRB=(PROT,NORM),               X
               INITIAL='AUTHORITY CODE  : '
DA1AUCO  DFHMDF POS=(13,20),LENGTH=20,ATTRB=(UNPROT)
         DFHMDF POS=(14,2),LENGTH=18,ATTRB=(PROT,NORM),               X
               INITIAL='AUTHORITY NAME  : '
DA1AUNM  DFHMDF POS=(14,20),LENGTH=50,ATTRB=(PROT,NORM)
         DFHMDF POS=(15,2),LENGTH=18,ATTRB=(PROT,NORM),               X
               INITIAL='DECISION        : '
DA1DEC   DFHMDF POS=(15,20),LENGTH=1,ATTRB=(UNPROT)
         DFHMDF POS=(15,22),LENGTH=22,ATTRB=(PROT,NORM),              X
               INITIAL='(A=APPROVE  R=REJECT)'
         DFHMDF POS=(16,2),LENGTH=18,ATTRB=(PROT,NORM),               X
               INITIAL='DECISION NOTES  : '
DA1DCNT  DFHMDF POS=(16,20),LENGTH=60,ATTRB=(UNPROT)
DA1MSG   DFHMDF POS=(22,2),LENGTH=76,ATTRB=(PROT,NORM)
         DFHMDF POS=(23,1),LENGTH=80,ATTRB=(PROT,NORM),               X
               INITIAL='--------------------------------------------------------------------------------'
         DFHMDF POS=(24,2),LENGTH=76,ATTRB=(PROT,NORM),               X
               INITIAL='F1=SUBMIT DECISION  F3=LOAD APP  F4=VALIDATE AUTHORITY  F12=EXIT'

         DFHMSD TYPE=FINAL
         END

