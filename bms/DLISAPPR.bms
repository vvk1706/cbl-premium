***================================================================***
*** BMS Mapset : DLISST - APPLICATION STATUS INQUIRY               ***
*** Map        : DLISST01  Trans: DL04                             ***
***================================================================***
DLISST   DFHMSD TYPE=&SYSPARM,                                         X
               LANG=COBOL,MODE=INOUT,TERM=3270-2,                      X
               CTRL=FREEKB,STORAGE=AUTO,TIOAPFX=YES

DLISST01 DFHMDI SIZE=(24,80),LINE=1,COLUMN=1

         DFHMDF POS=(1,1),LENGTH=80,ATTRB=(PROT,BRT),                 X
               INITIAL='DLIS           APPLICATION STATUS INQUIRY'
