//DLISCLNK PROC MEMBER=,
//         SRCLIB='DLIS.COBOL',
//         COPYLIB='DLIS.COPYBOOK',
//         LOADLIB='DLIS.LOADLIB',
//         DBRMLIB='DLIS.DBRM'
//*================================================================*
//* PROC  : DLISCLNK                                               *
//* Desc  : DB2 Precompile + COBOL Compile + Linkedit              *
//*================================================================*

//*----------- STEP 1: DB2 PRECOMPILE ----------------------------*
//PC       EXEC PGM=DSNHPC,PARM='HOST(COBOL),SOURCE,XREF'
//STEPLIB  DD DSN=DSN.SDSNLOAD,DISP=SHR
//DBRMLIB  DD DSN=&DBRMLIB(&MEMBER),DISP=SHR
//SYSCIN   DD DSN=&&DSNHOUT,DISP=(MOD,PASS),
//            UNIT=SYSDA,SPACE=(800,(500,500))
//SYSIN    DD DSN=&SRCLIB(&MEMBER),DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD SPACE=(800,(500,500)),UNIT=SYSDA
//SYSUT2   DD SPACE=(800,(500,500)),UNIT=SYSDA
//SYSUT3   DD SPACE=(800,(500,500)),UNIT=SYSDA

//*----------- STEP 2: COBOL COMPILE -----------------------------*
//COBOL    EXEC PGM=IGYCRCTL,COND=(8,LT,PC),
//         PARM='OBJECT,RENT,APOST,LIB,NOSEQ,NOTERM'
//STEPLIB  DD DSN=IGY.SIGYCOMP,DISP=SHR
//SYSLIB   DD DSN=&COPYLIB,DISP=SHR
//SYSIN    DD DSN=&&DSNHOUT,DISP=(OLD,DELETE)
//SYSLIN   DD DSN=&&LOADSET,DISP=(MOD,PASS),
//            UNIT=SYSDA,SPACE=(800,(500,500))
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD SPACE=(800,(500,500)),UNIT=SYSDA
//SYSUT2   DD SPACE=(800,(500,500)),UNIT=SYSDA
//SYSUT3   DD SPACE=(800,(500,500)),UNIT=SYSDA
//SYSUT4   DD SPACE=(800,(500,500)),UNIT=SYSDA
//SYSUT5   DD SPACE=(800,(500,500)),UNIT=SYSDA
//SYSUT6   DD SPACE=(800,(500,500)),UNIT=SYSDA
//SYSUT7   DD SPACE=(800,(500,500)),UNIT=SYSDA

//*----------- STEP 3: LINKEDIT ----------------------------------*
//LKED     EXEC PGM=IEWL,COND=(8,LT,COBOL),
//         PARM='RENT,REFR,REUS,AMODE(31),RMODE(ANY)'
//SYSLIB   DD DSN=CEE.SCEELKED,DISP=SHR
//         DD DSN=DSN.SDSNLOAD,DISP=SHR
//         DD DSN=CICSTS.SDFHLOAD,DISP=SHR
//SYSLMOD  DD DSN=&LOADLIB(&MEMBER),DISP=SHR
//SYSLIN   DD DSN=&&LOADSET,DISP=(OLD,DELETE)
//         DD *
  NAME &MEMBER(R)
//*
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD SPACE=(1024,(200,20)),UNIT=SYSDA

        PEND
