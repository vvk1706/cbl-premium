//DLISBASM PROC MEMBER=,
//         SRCLIB='DLIS.BMS',
//         LOADLIB='DLIS.LOADLIB'
//*================================================================*
//* PROC  : DLISBASM                                               *
//* Desc  : BMS Map Assembly (Phase 1 + Phase 2)                   *
//*================================================================*

//*----------- PHASE 1: MAP ASSEMBLY (copy for CICS) -------------*
//ASM1     EXEC PGM=ASMA90,
//         PARM='SYSPARM(MAP),DECK,NOOBJECT'
//SYSLIB   DD DSN=CICSTS.SDFHMAC,DISP=SHR
//         DD DSN=SYS1.MACLIB,DISP=SHR
//SYSIN    DD DSN=&SRCLIB(&MEMBER),DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DSN=&&MAPOUT,DISP=(,PASS),
//            UNIT=SYSDA,SPACE=(800,(500,500))
//SYSUT1   DD SPACE=(800,(500,500)),UNIT=SYSDA

//*----------- PHASE 2: SYMBOLIC MAP ASSEMBLY (copy for COBOL) ---*
//ASM2     EXEC PGM=ASMA90,COND=(8,LT,ASM1),
//         PARM='SYSPARM(DSECT),DECK,NOOBJECT'
//SYSLIB   DD DSN=CICSTS.SDFHMAC,DISP=SHR
//         DD DSN=SYS1.MACLIB,DISP=SHR
//SYSIN    DD DSN=&SRCLIB(&MEMBER),DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DSN=DLIS.COPYBOOK(&MEMBER),DISP=SHR
//SYSUT1   DD SPACE=(800,(500,500)),UNIT=SYSDA

//*----------- LINKEDIT (phase 1 output into load library) ------*
//LKED     EXEC PGM=IEWL,COND=(8,LT,ASM2),
//         PARM='RENT,REFR,REUS'
//SYSLIB   DD DSN=CICSTS.SDFHLOAD,DISP=SHR
//SYSLMOD  DD DSN=&LOADLIB(&MEMBER),DISP=SHR
//SYSLIN   DD DSN=&&MAPOUT,DISP=(OLD,DELETE)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD SPACE=(1024,(200,20)),UNIT=SYSDA

        PEND
